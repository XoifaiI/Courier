struct Entity { id: u8, x: u8, y: u8, z: u8, orientation: u8, animation: u8 }

event Booleans from Client { Data: bool[..1000] }
event Entities from Client { Data: Entity[..1000] }

event Strings from Client { Data: string(..50)[..500] }
event Numbers from Client { Data: u8[..2000] }
event Dict from Client { Data: map(string(..50), u8, ..500) }
event Vectors from Client { Data: vector[..500] }

struct Unit { id: u16, position: vector, yaw: u16, health: u8 }
struct HitData { attacker: u16, target: u16, damage: u8 }
struct PickupData { item: u16, slot: u8 }
struct InputData { move: vector, look: vector, jump: bool, fire: bool, crouch: bool }

event State from Server { Data: Unit[..64] }
event Hit from Server { Data: HitData }
event Pickup from Server { Data: PickupData }
event Chat from Server { Data: string(..200) }
event Input from Client { Data: InputData }
